# Copy to .env and fill in. .env is gitignored.

# LLM (optional: outside-view priors + headline classification)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# News ingestion (be a good citizen; include a contact)
NEWS_USER_AGENT=Superforecaster (your-email@example.com)

# Storage
DB_PATH=data/forecaster.db
CALIBRATOR_PATH=data/calibrators.json
MODEL_PATH=data/forecast_model.json

LOG_LEVEL=INFO
